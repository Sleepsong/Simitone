diff --git a/TSOClient/tso.content/TS1/TS1Audio.cs b/TSOClient/tso.content/TS1/TS1Audio.cs
index de17208..0b35b3a 100644
--- a/TSOClient/tso.content/TS1/TS1Audio.cs
+++ b/TSOClient/tso.content/TS1/TS1Audio.cs
@@ -150,7 +150,7 @@ namespace FSO.Content.TS1
