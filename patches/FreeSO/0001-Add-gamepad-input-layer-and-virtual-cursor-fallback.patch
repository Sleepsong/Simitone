+++ b/TSOClient/tso.common/Rendering/Framework/IO/GamePadSettings.cs
@@ -0,0 +1,56 @@
+using System;
+
+namespace FSO.Common.Rendering.Framework.IO
+{
+    /// <summary>
+    /// Gamepad options. These live in tso.common so the input loop can read them; the frontend fills them
+    /// in from its own persisted settings via <see cref="Configure"/>.
+    /// </summary>
+    public static class GamePadSettings
+    {
+        public static bool Enabled = true;
+
+        /// <summary>Radial stick dead zone, 0-0.9.</summary>
+        public static float DeadZone = 0.2f;
+
+        /// <summary>
+        /// Lets the left stick drive a stand-in mouse cursor on screens that have no native gamepad support.
+        /// </summary>
+        public static bool VirtualCursor = true;
+
+        /// <summary>Multiplier on the virtual cursor's base speed.</summary>
+        public static float CursorSpeed = 1f;
+
+        public static PadBindings Bindings = new PadBindings();
+
+        /// <summary>
+        /// Applies persisted settings. If <paramref name="overridesPath"/> exists, its bindings are applied on
+        /// top of the defaults; the returned string describes any lines that were skipped, or is null.
+        /// </summary>
+        public static string Configure(bool enabled, float deadZone, bool virtualCursor, float cursorSpeed,
+            bool swapConfirmCancel, string overridesPath)
+        {
+            Enabled = enabled;
+            DeadZone = Math.Clamp(deadZone, 0f, 0.9f);
+            VirtualCursor = virtualCursor;
+            CursorSpeed = Math.Clamp(cursorSpeed, 0.1f, 5f);
+
+            var bindings = new PadBindings(swapConfirmCancel);
+            string problems = null;
+            if (overridesPath != null)
+            {
+                try
+                {
+                    var errors = bindings.LoadOverrides(overridesPath);
+                    if (errors.Count > 0) problems = overridesPath + ": " + string.Join("; ", errors);
+                }
+                catch (Exception e)
+                {
+                    problems = overridesPath + ": " + e.Message;
+                }
+            }
+            Bindings = bindings;
+            return problems;
+        }
+    }
+}
diff --git a/TSOClient/tso.common/Rendering/Framework/IO/PadBindings.cs b/TSOClient/tso.common/Rendering/Framework/IO/PadBindings.cs
new file mode 100644
index 0000000..227576d
--- /dev/null
+++ b/TSOClient/tso.common/Rendering/Framework/IO/PadBindings.cs
@@ -0,0 +1,102 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using Microsoft.Xna.Framework.Input;
+
+namespace FSO.Common.Rendering.Framework.IO
+{
+    /// <summary>
+    /// Maps each <see cref="PadAction"/> to one or more physical buttons. Any bound button holds the action down.
+    /// </summary>
+    public class PadBindings
+    {
+        private readonly Buttons[][] Map = new Buttons[GamePadInput.ActionCount][];
+
+        public PadBindings() : this(false) { }
+
+        /// <param name="swapConfirmCancel">Put Confirm on B and Cancel on A, matching Nintendo-style layouts.</param>
+        public PadBindings(bool swapConfirmCancel)
+        {
+            Set(PadAction.Confirm, swapConfirmCancel ? Buttons.B : Buttons.A);
+            Set(PadAction.Cancel, swapConfirmCancel ? Buttons.A : Buttons.B);
+            Set(PadAction.FaceLeft, Buttons.X);
+            Set(PadAction.FaceTop, Buttons.Y);
+            Set(PadAction.ShoulderLeft, Buttons.LeftShoulder);
+            Set(PadAction.ShoulderRight, Buttons.RightShoulder);
+            Set(PadAction.TriggerLeft, Buttons.LeftTrigger);
+            Set(PadAction.TriggerRight, Buttons.RightTrigger);
+            Set(PadAction.Up, Buttons.DPadUp);
+            Set(PadAction.Down, Buttons.DPadDown);
+            Set(PadAction.Left, Buttons.DPadLeft);
+            Set(PadAction.Right, Buttons.DPadRight);
+            Set(PadAction.Start, Buttons.Start);
+            Set(PadAction.Select, Buttons.Back);
+            Set(PadAction.LeftStickClick, Buttons.LeftStick);
+            Set(PadAction.RightStickClick, Buttons.RightStick);
+        }
+
+        public Buttons[] Get(PadAction action) => Map[(int)action];
+
+        public void Set(PadAction action, params Buttons[] buttons)
+        {
+            Map[(int)action] = buttons ?? Array.Empty<Buttons>();
+        }
+
+        /// <summary>
+        /// Applies overrides from a plain text file with one binding per line:
+        /// <code>
+        /// # comments start with '#'
+        /// Confirm = A
+        /// Cancel = B, Back
+        /// </code>
+        /// Action names are <see cref="PadAction"/> members and button names are XNA <see cref="Buttons"/> members,
+        /// both case-insensitive. Lines that don't parse are skipped and reported in the returned list,
+        /// so a typo never leaves an action unbound.
+        /// </summary>
+        public List<string> LoadOverrides(string path)
+        {
+            var errors = new List<string>();
+            if (!File.Exists(path)) return errors;
+
+            var lineNo = 0;
+            foreach (var rawLine in File.ReadAllLines(path))
+            {
+                lineNo++;
+                var line = rawLine.Trim();
+                if (line.Length == 0 || line[0] == '#') continue;
+
+                var split = line.IndexOf('=');
+                if (split < 1)
+                {
+                    errors.Add($"line {lineNo}: expected 'Action = Button[, Button]'");
+                    continue;
+                }
+
+                var actionName = line.Substring(0, split).Trim();
+                if (!System.Enum.TryParse(actionName, true, out PadAction action))
+                {
+                    errors.Add($"line {lineNo}: unknown action '{actionName}'");
+                    continue;
+                }
+
+                var buttons = new List<Buttons>();
+                var valid = true;
+                foreach (var part in line.Substring(split + 1).Split(','))
+                {
+                    var name = part.Trim();
+                    if (name.Length == 0) continue;
+                    if (System.Enum.TryParse(name, true, out Buttons button)) buttons.Add(button);
+                    else
+                    {
+                        errors.Add($"line {lineNo}: unknown button '{name}'");
+                        valid = false;
+                    }
+                }
+
+                if (valid && buttons.Count > 0) Set(action, buttons.ToArray());
+                else if (valid) errors.Add($"line {lineNo}: no buttons given for '{actionName}'");
+            }
+            return errors;
+        }
+    }
+}
diff --git a/TSOClient/tso.common/Rendering/Framework/IO/PointerDeviceTracker.cs b/TSOClient/tso.common/Rendering/Framework/IO/PointerDeviceTracker.cs
new file mode 100644
index 0000000..8b51247
--- /dev/null
+++ b/TSOClient/tso.common/Rendering/Framework/IO/PointerDeviceTracker.cs
@@ -0,0 +1,66 @@
+using System;
+using Microsoft.Xna.Framework;
+using Microsoft.Xna.Framework.Input;
+
+namespace FSO.Common.Rendering.Framework.IO
+{
+    /// <summary>
+    /// Decides whether the mouse or the gamepad is driving the pointer. Whichever was used most recently wins.
+    /// Keyboard input never changes the device, and the mouse wins ties.
+    /// </summary>
+    public class PointerDeviceTracker
+    {
+        /// <summary>
+        /// Pixels the mouse must move before it counts as the player using it. Absorbs rounding when the OS
+        /// reports a warped cursor position back to us.
+        /// </summary>
+        public const int MoveTolerance = 3;
+
+        private MouseState LastReal;
+        private bool HadFocus;
+
+        /// <param name="current">The device chosen last frame.</param>
+        /// <param name="real">This frame's hardware mouse state.</param>
+        /// <param name="padActive">The pad was newly used this frame (GamePadInput.Active).</param>
+        /// <param name="lastWarp">Where the virtual cursor last moved the OS cursor, if anywhere.</param>
+        /// <returns>The device for this frame.</returns>
+        public InputDevice Update(InputDevice current, MouseState real, bool hasFocus, bool padActive, Point? lastWarp)
+        {
+            if (!hasFocus)
+            {
+                //the mouse state is zeroed while unfocused, so regaining focus must not look like mouse movement.
+                HadFocus = false;
+                return current;
+            }
+
+            var result = current;
+            if (HadFocus && MouseWasUsed(real, lastWarp)) result = InputDevice.Mouse;
+            else if (padActive) result = InputDevice.GamePad;
+
+            LastReal = real;
+            HadFocus = true;
+            return result;
+        }
+
+        private bool MouseWasUsed(MouseState real, Point? lastWarp)
+        {
+            var last = LastReal;
+            var moved = Distance(real.Position, last.Position) > MoveTolerance
+                && (lastWarp == null || Distance(real.Position, lastWarp.Value) > MoveTolerance);
+
+            var clicked = (real.LeftButton == ButtonState.Pressed && last.LeftButton == ButtonState.Released)
+                || (real.RightButton == ButtonState.Pressed && last.RightButton == ButtonState.Released)
+                || (real.MiddleButton == ButtonState.Pressed && last.MiddleButton == ButtonState.Released);
+
+            var scrolled = real.ScrollWheelValue != last.ScrollWheelValue
+                || real.HorizontalScrollWheelValue != last.HorizontalScrollWheelValue;
+
+            return moved || clicked || scrolled;
+        }
+
+        private static int Distance(Point a, Point b)
+        {
+            return Math.Max(Math.Abs(a.X - b.X), Math.Abs(a.Y - b.Y));
+        }
+    }
+}
diff --git a/TSOClient/tso.common/Rendering/Framework/IO/VirtualCursor.cs b/TSOClient/tso.common/Rendering/Framework/IO/VirtualCursor.cs
new file mode 100644
index 0000000..802d2f7
--- /dev/null
+++ b/TSOClient/tso.common/Rendering/Framework/IO/VirtualCursor.cs
@@ -0,0 +1,99 @@
+using System;
+using FSO.Common.Rendering.Framework.Model;
+using Microsoft.Xna.Framework;
+using Microsoft.Xna.Framework.Input;
+
+namespace FSO.Common.Rendering.Framework.IO
+{
+    /// <summary>
+    /// Fallback pointer for screens with no native gamepad support. While the pad is the active device it
+    /// replaces the frame's mouse state:
+    /// <list type="bullet">
+    /// <item>left stick moves the cursor (quadratic response for precision near the centre)</item>
+    /// <item>Confirm = left button, FaceLeft = right button, FaceTop = middle button</item>
+    /// <item>right trigger / left trigger scroll the wheel up / down</item>
+    /// <item>Cancel holds Escape</item>
+    /// </list>
+    /// The OS cursor is warped to the virtual position so the game's normal cursor graphics appear there.
+    /// </summary>
+    public class VirtualCursor
+    {
+        private const float BaseSpeed = 1000f; //px per second at full deflection, for a 1080px tall window
+        private const float WheelRate = 1200f; //wheel units per second at full trigger (120 = one notch)
+
+        private Vector2 Position;
+        private float WheelRemainder;
+
+        /// <summary>
+        /// Total synthetic scroll so far. It's added to the real wheel value in every mode, so the value
+        /// consumers see stays continuous when the player swaps between mouse and pad.
+        /// </summary>
+        public int WheelOffset { get; private set; }
+
+        /// <summary>Where the OS cursor was last warped to, so the warp isn't mistaken for the player moving the mouse.</summary>
+        public Point? LastWarp { get; private set; }
+
+        /// <summary>Moves the OS cursor. Replaceable so the cursor can run without a window (tests).</summary>
+        public Action<int, int> Warp = Mouse.SetPosition;
+
+        public void MoveTo(Point position, int width, int height)
+        {
+            Position = Clamp(position.ToVector2(), width, height);
+        }
+
+        /// <summary>Replaces the frame's mouse and keyboard state with the gamepad-driven equivalents.</summary>
+        public void Apply(UpdateState state, GameTime time, int width, int height)
+        {
+            var pad = state.Pad;
+            var dt = (float)Math.Min(time.ElapsedGameTime.TotalSeconds, 0.1);
+
+            var stick = pad.LeftStick;
+            if (stick != Vector2.Zero)
+            {
+                //velocity grows with the square of deflection: small pushes for precise aiming, full tilt to cross the screen.
+                var speed = BaseSpeed * GamePadSettings.CursorSpeed * (height / 1080f) * stick.Length();
+                Position = Clamp(Position + new Vector2(stick.X, -stick.Y) * speed * dt, width, height);
+            }
+
+            WheelRemainder += (pad.RightTrigger - pad.LeftTrigger) * WheelRate * dt;
+            var wholeTicks = (int)WheelRemainder;
+            WheelRemainder -= wholeTicks;
+            WheelOffset += wholeTicks;
+
+            var real = state.MouseState;
+            var point = new Point((int)Position.X, (int)Position.Y);
+            state.MouseState = new MouseState(
+                point.X, point.Y,
+                real.ScrollWheelValue, //WheelOffset is applied by the caller in every mode
+                pad.IsDown(PadAction.Confirm) ? ButtonState.Pressed : ButtonState.Released,
+                pad.IsDown(PadAction.FaceTop) ? ButtonState.Pressed : ButtonState.Released,
+                pad.IsDown(PadAction.FaceLeft) ? ButtonState.Pressed : ButtonState.Released,
+                ButtonState.Released,
+                ButtonState.Released,
+                real.HorizontalScrollWheelValue);
+
+            if (pad.IsDown(PadAction.Cancel) && !state.KeyboardState.IsKeyDown(Keys.Escape))
+            {
+                var held = state.KeyboardState.GetPressedKeys();
+                var keys = new Keys[held.Length + 1];
+                held.CopyTo(keys, 0);
+                keys[held.Length] = Keys.Escape;
+                state.KeyboardState = new KeyboardState(keys, state.KeyboardState.CapsLock, state.KeyboardState.NumLock);
+            }
+
+            if (LastWarp != point)
+            {
+                Warp(point.X, point.Y);
+                LastWarp = point;
+            }
+        }
+
+        private static Vector2 Clamp(Vector2 position, int width, int height)
+        {
+            //stay strictly inside the window: the UI layer treats the edge pixels as "outside" and stops dispatching events.
+            return new Vector2(
+                Math.Clamp(position.X, 1, Math.Max(1, width - 2)),
+                Math.Clamp(position.Y, 1, Math.Max(1, height - 2)));
+        }
+    }
+}
